# Copia a .env (chmod 600 en el VPS). Nunca subas .env al repositorio.
NODE_ENV=development

# Base de datos SQLite (WAL). Respaldar = copiar este archivo.
DATABASE_PATH=./data/atoyac.db
# Carpeta de migraciones Drizzle (relativa a donde corre el servidor)
MIGRATIONS_DIR=./drizzle
# Zona horaria para el reinicio diario del turno
TZ_NEGOCIO=America/Mexico_City

# Sesiones: cadena larga aleatoria (openssl rand -hex 32). Obligatoria en producción.
SESSION_SECRET=
# PIN por rol (4 a 8 dígitos). En desarrollo, si faltan: 1111 / 2222 / 3333. Obligatorios en producción.
PIN_ADMIN=
PIN_CAJA=
PIN_COCINA=

# Servidor (adapter-node). En el VPS: 127.0.0.1:3095 detrás de nginx.
PORT=3095
HOST=127.0.0.1
# Detrás de nginx, para que el límite de intentos de login vea la IP real:
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# Mercado Pago Point (cobro con tarjeta)
MP_TOKEN=
MP_TERMINAL=

# WhatsApp Cloud API (ticket)
WA_TOKEN=
WA_PHONE_ID=

# Apps de delivery (las define cada builder de canales; se listan aquí al integrarlas)
# DIDI_CLIENT_ID=
# DIDI_CLIENT_SECRET=
# RAPPI_CLIENT_ID=
# RAPPI_CLIENT_SECRET=
# UBER_CLIENT_ID=
# UBER_CLIENT_SECRET=
# UBER_WEBHOOK_SECRET=
