{
  "name": "atoyac",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "seed": "tsx src/lib/server/db/seed.ts",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.6",
    "@sveltejs/kit": "^3.4.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.11",
    "drizzle-kit": "^0.31.11",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  }
}
